generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  phone             String?
  /// Short code this user shares to earn referral commission.
  referralCode      String?   @unique
  /// Who referred this user, resolved at signup and never changed afterwards.
  referredById      String?
  /// scrypt hash — the password itself is never stored and cannot be recovered.
  passwordHash      String?
  /// Profile picture, stored as a URL or data URI.
  avatarUrl         String?
  /// Set when the operator forced a reset; the user must pick a new password.
  mustChangePassword Boolean  @default(false)
  isAdmin           Boolean   @default(false)
  /// Consecutive failed logins; resets on success.
  loginAttempts     Int       @default(0)
  lockedUntil       DateTime?
  /// Set when the welcome email actually went out, so it is sent exactly once.
  welcomedAt        DateTime?
  dailyPaceMinutes  Int?
  focusCategory     String?
  quizAnswers       String?
  aiReadinessScore  Int?
  archetype         String?
  createdAt         DateTime  @default(now())

  orders         Order[]
  completions    LessonCompletion[]
  badges         UserBadge[]
  messages       ChatMessage[]
  passwordResets PasswordReset[]

  referredBy      User?             @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]            @relation("Referrals")
  earnings        ReferralEarning[] @relation("Earner")
  generatedFor    ReferralEarning[] @relation("Referred")
  payouts         Payout[]

  @@index([referredById])
}

/// One commission line: earner X gets paid because referred user Y purchased.
model ReferralEarning {
  id             String   @id @default(cuid())
  userId         String
  referredUserId String
  /// The purchase that triggered it — also the dedupe key.
  orderId        String   @unique
  amountEgp      Int
  /// available = withdrawable · locked = inside a payout request · paid = sent
  status         String   @default("available")
  payoutId       String?
  createdAt      DateTime @default(now())

  user         User    @relation("Earner", fields: [userId], references: [id])
  referredUser User    @relation("Referred", fields: [referredUserId], references: [id])
  payout       Payout? @relation(fields: [payoutId], references: [id])

  @@index([userId, status])
}

/// A withdrawal request the operator settles by hand.
model Payout {
  id          String    @id @default(cuid())
  userId      String
  amountEgp   Int
  /// vodafone_cash | instapay
  method      String
  /// Wallet number or InstaPay handle the money should go to.
  destination String
  /// requested | paid | rejected
  status      String    @default("requested")
  note        String?
  requestedAt DateTime  @default(now())
  settledAt   DateTime?

  user     User              @relation(fields: [userId], references: [id])
  earnings ReferralEarning[]

  @@index([status])
}

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  /// Failed guesses against this code. Caps brute-forcing a 6-digit secret.
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([email, createdAt])
}

/// A single-use link for setting a new password after "نسيت الباسورد".
///
/// Only the SHA-256 of the token is stored, so a stolen database still cannot
/// be used to take over accounts — the raw token exists only inside the email.
model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Order {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  method          String
  amountEgp       Int
  originalPriceEgp Int      @default(2000)
  status          String    @default("pending")
  proofChannel    String?
  /// Number the customer transfers from — used to match a Vodafone Cash SMS.
  senderPhone     String?
  /// InstaPay receipts carry no phone, only the payer's name — captured here
  /// at checkout so an incoming IPN transfer can be attributed.
  instapayName    String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())

  user     User                 @relation(fields: [userId], references: [id])
  course   Course               @relation(fields: [courseId], references: [id])
  payments PaymentTransaction[]

  @@index([status])
  @@index([senderPhone])
}

model Course {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String
  icon          String
  category      String
  badge         String?
  level         String?
  totalLessons  Int      @default(0)
  totalXp       Int      @default(0)
  isComingSoon  Boolean  @default(false)
  order         Int      @default(0)

  modules Module[]
  orders  Order[]
}

model Module {
  id          String @id @default(cuid())
  courseId    String
  order       Int
  title       String
  description String
  icon        String

  course  Course   @relation(fields: [courseId], references: [id])
  lessons Lesson[]
}

model Lesson {
  id           String  @id @default(cuid())
  moduleId     String
  dayNumber    Int
  title        String
  durationMin  Int
  xp           Int
  order        Int
  isCheckpoint Boolean @default(false)

  module        Module             @relation(fields: [moduleId], references: [id])
  cards         LessonCard[]
  quizQuestions QuizQuestion[]
  completions   LessonCompletion[]
}

model LessonCard {
  id      String @id @default(cuid())
  lessonId String
  order   Int
  type    String
  heading String?
  body    String

  lesson Lesson @relation(fields: [lessonId], references: [id])
}

model QuizQuestion {
  id            String @id @default(cuid())
  lessonId      String
  order         Int
  type          String
  question      String
  options       String
  correctIndex  Int
  explanation   String

  lesson Lesson @relation(fields: [lessonId], references: [id])
}

model LessonCompletion {
  id             String   @id @default(cuid())
  userId         String
  lessonId       String
  score           Int
  totalQuestions  Int
  xpEarned        Int
  completedAt     DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

/// A payment SMS forwarded by the receiver phone. One row per real transfer.
/// The app only reports; every decision about activation is made here.
model PaymentTransaction {
  id             String   @id @default(cuid())
  provider       String
  amountEgp      Int
  currency       String   @default("EGP")
  /// Provider's own reference. Unique when present — the primary dedupe key.
  transactionRef String?  @unique
  /// Fallback dedupe key when the SMS carries no reference of its own.
  fingerprint    String   @unique
  senderPhone    String?
  receiverPhone  String?
  transactionAt  DateTime?
  smsReceivedAt  DateTime?
  rawSms         String
  /// unmatched | matched | ignored
  status         String   @default("unmatched")
  matchedOrderId String?
  matchNote      String?
  createdAt      DateTime @default(now())

  matchedOrder Order? @relation(fields: [matchedOrderId], references: [id])

  @@index([status])
  @@index([senderPhone])
}

model Badge {
  id          String @id @default(cuid())
  key         String @unique
  title       String
  description String
  icon        String

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
