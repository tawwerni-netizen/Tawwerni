{
  "name": "tawwerni",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-community": "tsx scripts/seed-community-300.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "//": "Hostinger installs with devDependencies omitted, so anything the BUILD touches has to live in dependencies — Tailwind's PostCSS plugin, the TypeScript compiler and its @types, and prisma+dotenv for the postinstall generate. Only the tools that never run on the server stay below.",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.1.0",
    "jose": "^6.2.10",
    "mariadb": "^3.5.3",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.23.12"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
